# Copy to .env and fill these values locally. Never send them in chat or commit .env.
DATABASE_URL=<INSIRA_PESSOALMENTE>
GEMINI_API_KEY=<INSIRA_PESSOALMENTE>
APP_API_KEY=<GERE_LOCALMENTE_COM_PELO_MENOS_16_CARACTERES>

# Non-secret runtime settings
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_ATTEMPTS=2
MAX_MESSAGE_CHARS=5000
MAX_BODY_BYTES=16384
LOG_LEVEL=INFO
